
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

<h2>Welcome to Dashboard, @Session["Username"]</h2>


<div class="row">
    <div class="col-md-4">
        <div class="alert alert-info">
            <strong>Total Users:</strong> @ViewBag.total
        </div>
    </div>
    <div class="col-md-4">
        <div class="alert alert-success">
            <strong>Active Users:</strong> @ViewBag.active
        </div>
    </div>
    <div class="col-md-4">
        <div class="alert alert-danger">
            <strong>Inactive Users:</strong> @ViewBag.Inactive
        </div>
    </div>
</div>

